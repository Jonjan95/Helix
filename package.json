{
  "name": "helix-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "evidence:capture": "node scripts/capture-release-evidence.mjs",
    "evidence:spatial": "node scripts/capture-spatial-evidence.mjs",
    "evidence:threshold": "node scripts/capture-threshold-evidence.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "assets:generate": "node scripts/generate-release-assets.mjs",
    "test:e2e": "playwright test",
    "test:release": "playwright test --config=playwright.release.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "validate": "npm run lint && npm run typecheck && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "next": "16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.185.1"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "typescript": "5.9.3"
  }
}
